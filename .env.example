# Google Gemini API Key (Requerido para extracción multimodal y auditoría con Gemini 1.5 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Apify Token (Opcional si se utiliza actor de Apify en lugar de Playwright local)
APIFY_TOKEN=

# Configuración de Entornos y Rutas
NODE_ENV=development
DOWNLOAD_DIR=./storage/raw_bases
OUTPUT_DIR=./storage/matrices_generadas

# Configuración de Alertas (Opcional - WhatsApp / Webhooks)
WHATSAPP_ADMIN_PHONE=51999999999
WEBHOOK_ALERT_URL=
