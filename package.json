{
  "name": "licitaciones-qp-engine",
  "version": "1.0.0",
  "description": "Backend headless y pipeline determinista de auditoría de licitaciones públicas (SEACE / OSCE)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli/index.ts",
    "cli": "tsx src/cli/index.ts",
    "scrape:salud": "tsx src/cli/index.ts --mode scrape --sector salud",
    "audit": "tsx src/cli/index.ts --mode audit",
    "worker": "tsx src/scheduler/autonomous_worker.ts",
    "worker:prod": "node dist/scheduler/autonomous_worker.js",
    "test:evaluator": "tsx src/test/test_evaluator.ts",
    "test:pdf": "tsx src/test/test_pdf_generation.ts"
  },
  "keywords": [
    "seace",
    "osce",
    "licitaciones",
    "rag",
    "gemini",
    "b2b"
  ],
  "author": "Kenneth & Smith",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@supabase/supabase-js": "^2.115.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^16.4.7",
    "node-cron": "^4.6.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "playwright": "^1.50.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "unpdf": "^1.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
